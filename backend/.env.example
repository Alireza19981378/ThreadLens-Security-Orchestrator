DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SCANNER_RUN_INLINE=true
SCANNER_MOCK_MODE=false
SCANNER_WORK_DIR=./var/scans
TOOL_LOCK_DIR=./var/tool_locks
TOOL_CRAWLER_INTERVAL_SECONDS=21600
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
FILE_SANDBOX_ENABLED=true
FILE_SANDBOX_MAX_UPLOAD_MB=50
FILE_SANDBOX_STORAGE_DIR=./var/file_sandbox
CLAMAV_ENABLED=true
CLAMSCAN_BIN=clamscan
FRESHCLAM_BIN=freshclam
YARA_ENABLED=true
YARA_BIN=yara
YARA_RULES_DIR=./var/yara_rules
YARA_RULE_REPOS=https://github.com/Yara-Rules/rules,https://github.com/Neo23x0/signature-base
EXIFTOOL_ENABLED=true
EXIFTOOL_BIN=exiftool
PDFINFO_ENABLED=true
PDFINFO_BIN=pdfinfo
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=multiav-tool-logs
LOG_FILE_PATH=var/logs/app.log
UPDATE_CLAMAV_DB_ON_START=false
SEED_YARA_RULES=false
CLAMAV_UPDATE_COMMAND=
TRIVY_UPDATE_COMMAND=
GRYPE_UPDATE_COMMAND=
GRANT_UPDATE_COMMAND=
OSV_SCANNER_UPDATE_COMMAND=
