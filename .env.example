DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=multiav
POSTGRES_USER=multiav
POSTGRES_PASSWORD=multiav-change-me

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
MAX_UPLOAD_SIZE=104857600
FILE_SANDBOX_ENABLED=true
FILE_SANDBOX_MAX_UPLOAD_MB=50
FILE_SANDBOX_STORAGE_DIR=/app/var/file_sandbox
TOOL_LOCK_DIR=/app/var/tool_locks
TOOL_CRAWLER_INTERVAL_SECONDS=21600

CLAMAV_ENABLED=true
CLAMSCAN_BIN=clamscan
FRESHCLAM_BIN=freshclam
YARA_ENABLED=true
YARA_BIN=yara
YARA_RULES_DIR=/app/var/yara_rules
YARA_RULE_REPOS=https://github.com/Yara-Rules/rules,https://github.com/Neo23x0/signature-base
EXIFTOOL_ENABLED=true
EXIFTOOL_BIN=exiftool
PDFINFO_ENABLED=true
PDFINFO_BIN=pdfinfo

ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_INDEX=multiav-tool-logs
ELASTICSEARCH_URL=http://elasticsearch:9200
LOG_FILE_PATH=/app/var/logs/app.log

# Optional container startup maintenance.
UPDATE_CLAMAV_DB_ON_START=false
SEED_YARA_RULES=false

# Optional explicit binary update commands used by the Admin Tool Management UI.
# Leave empty unless you have reviewed the command for your environment.
CLAMAV_UPDATE_COMMAND=
TRIVY_UPDATE_COMMAND=
GRYPE_UPDATE_COMMAND=
GRANT_UPDATE_COMMAND=
OSV_SCANNER_UPDATE_COMMAND=
